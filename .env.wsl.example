# WSL Ubuntu production profile (copy to .env, never commit populated values)
RECLUTA_DATA_ROOT=/mnt/d/ReclutaProntoData
MARIADB_DATABASE=frappe
MARIADB_USER=frappe
FRAPPE_SITE_NAME=recluta.localhost
FRAPPE_APPS=erpnext,hrms
FRAPPE_PORT=8000
EVOLUTION_POSTGRES_DB=evolution
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_DATABASE_PROVIDER=postgresql
EVOLUTION_PORT=8080
DOCLING_PORT=5001
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
N8N_CONCURRENCY=2
# Fill these locally before starting; do not commit this file after filling.
MARIADB_ROOT_PASSWORD=change-me
MARIADB_PASSWORD=change-me
EVOLUTION_API_KEY=change-me
EVOLUTION_POSTGRES_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me
