# Copy to .env locally. Never commit the populated file.
RECLUTA_DATA_ROOT=D:/ReclutaProntoData
MARIADB_ROOT_PASSWORD=change-me-locally
MARIADB_PASSWORD=change-me-locally
MARIADB_DATABASE=frappe
MARIADB_USER=frappe
FRAPPE_SITE_NAME=recluta.localhost
FRAPPE_APPS=erpnext,hrms
EVOLUTION_API_KEY=change-me-locally
EVOLUTION_POSTGRES_DB=evolution
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=change-me-locally
# Optional external database override:
# EVOLUTION_DATABASE_CONNECTION_URI=postgresql://user:password@host:5432/evolution
N8N_ENCRYPTION_KEY=generate-a-long-random-key-locally

# Optional image overrides; pin tested digests before production use.
# FRAPPE_IMAGE=frappe/erpnext:v15
# EVOLUTION_IMAGE=atendai/evolution-api:v2.2.3
# DOCLING_IMAGE=quay.io/docling-project/docling-serve:latest
